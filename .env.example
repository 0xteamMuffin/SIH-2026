POSTGRES_DB=sih_workbench
POSTGRES_USER=sih
POSTGRES_PASSWORD=change-me-postgres
DATABASE_URL=postgresql://sih:change-me-postgres@postgres:5432/sih_workbench

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
SEED_ADMIN_EMAIL=admin@sih.local
SEED_ADMIN_PASSWORD=ChangeMe123!

MINIO_ROOT_USER=sih-minio
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET=workbench-artifacts
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=sih-minio
S3_SECRET_KEY=change-me-minio-password

QDRANT_URL=http://qdrant:6333

# development = OpenRouter only; sovereign = internal local model only.
APP_MODE=development
MODEL_PROVIDER=openrouter
# Optional validated JSON array of model profiles. When empty, the provider defaults below are used.
MODEL_REGISTRY_JSON=
MODEL_REQUEST_TIMEOUT_MS=120000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
LOCAL_MODEL_BASE_URL=http://ollama:11434/v1
LOCAL_MODEL_API_KEY=local-no-key
LOCAL_GENERAL_MODEL=llama3.2
LOCAL_VISION_MODEL=llama3.2-vision
LOCAL_CODE_MODEL=qwen2.5-coder:7b

API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
