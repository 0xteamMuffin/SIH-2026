POSTGRES_DB=sih_workbench
POSTGRES_USER=sih
POSTGRES_PASSWORD=change-me-postgres
DATABASE_URL=postgresql://sih:change-me-postgres@postgres:5432/sih_workbench

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
SEED_ADMIN_EMAIL=admin@sih.local
SEED_ADMIN_PASSWORD=ChangeMe123!

MINIO_ROOT_USER=sih-minio
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET=workbench-artifacts
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=sih-minio
S3_SECRET_KEY=change-me-minio-password

QDRANT_URL=http://qdrant:6333

RABBITMQ_DEFAULT_USER=sih
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq
AMQP_URL=amqp://sih:change-me-rabbitmq@rabbitmq:5672
QUEUE_PREFETCH=1
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY_MS=15000
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_BACKOFF_MS=60000
WORKER_SHUTDOWN_TIMEOUT_MS=30000
RUN_LEASE_DURATION_MS=30000
RUN_HEARTBEAT_INTERVAL_MS=10000
RUN_RECOVERY_POLL_INTERVAL_MS=15000

# Remote inference is for public or synthetic development data only.
APP_MODE=development
MODEL_CONFIG_PATH=config/models.json
ALLOW_REMOTE_INFERENCE=true
MODEL_REQUEST_TIMEOUT_MS=120000
REMOTE_MODEL_API_KEY=

API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
