POSTGRES_DB=sih_workbench
POSTGRES_USER=sih
POSTGRES_PASSWORD=change-me-postgres
DATABASE_URL=postgresql://sih:change-me-postgres@postgres:5432/sih_workbench

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
SEED_ADMIN_EMAIL=admin@sih.local
SEED_ADMIN_PASSWORD=ChangeMe123!

MINIO_ROOT_USER=sih-minio
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET=workbench-artifacts
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=sih-minio
S3_SECRET_KEY=change-me-minio-password

QDRANT_URL=http://qdrant:6333
# Replace before any shared, production, or sovereign deployment.
QDRANT_API_KEY=change-me-to-a-long-random-qdrant-api-key

DOCLING_BASE_URL=http://docling:5001
DOCLING_API_KEY=change-me-docling-api-key
DOCLING_REQUEST_TIMEOUT_MS=310000
EXTRACTION_STALE_TIMEOUT_MS=360000

RABBITMQ_DEFAULT_USER=sih
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq
AMQP_URL=amqp://sih:change-me-rabbitmq@rabbitmq:5672
QUEUE_PREFETCH=1
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY_MS=15000
KNOWLEDGE_QUEUE_PREFETCH=1
KNOWLEDGE_QUEUE_MAX_RETRIES=3
KNOWLEDGE_QUEUE_RETRY_DELAY_MS=15000
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_BACKOFF_MS=60000
WORKER_SHUTDOWN_TIMEOUT_MS=30000
RUN_LEASE_DURATION_MS=30000
RUN_HEARTBEAT_INTERVAL_MS=10000
RUN_RECOVERY_POLL_INTERVAL_MS=15000

# Remote inference is for public or synthetic development data only.
APP_MODE=development
MODEL_CONFIG_PATH=config/models.json
ALLOW_REMOTE_INFERENCE=true
MODEL_REQUEST_TIMEOUT_MS=120000
REMOTE_MODEL_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_API_TOKEN=
# Example: https://api.cloudflare.com/client/v4/accounts/ACCOUNT_ID/ai/v1
CLOUDFLARE_AI_BASE_URL=

API_PORT=4000
LOG_LEVEL=info
# Comma-separated exact browser origins. Leave empty to deny all cross-origin browser requests.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Number of trusted reverse-proxy hops between the client and API (0 for direct exposure).
TRUST_PROXY_HOPS=0
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=1000
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
NEXT_PUBLIC_API_URL=http://localhost:4000
