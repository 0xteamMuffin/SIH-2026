{
  "name": "sih-2026-backend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:security": "vitest run test/artifacts.routes.test.ts test/artifact-validation.test.ts test/agent.service.test.ts test/agent-approval.service.test.ts test/model-provider.test.ts test/embedding-provider.test.ts test/knowledge.routes.test.ts test/workspace-rbac.test.ts",
    "test:openapi": "vitest run test/openapi.test.ts",
    "test:migrations": "node ../ops/verify-empty-migrations.mjs",
    "test:acceptance": "node ../ops/backend-acceptance.mjs",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.735.0",
    "@prisma/client": "^6.5.0",
    "@prometheus-io/client": "^0.16.1",
    "@qdrant/js-client-rest": "~1.19.0",
    "amqplib": "^2.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "docx": "^9.5.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "file-type": "^22.0.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "pptxgenjs": "^4.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@scalar/openapi-parser": "^0.29.0",
    "@types/amqplib": "^0.10.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.1",
    "@types/supertest": "^7.2.1",
    "jszip": "^3.10.1",
    "prisma": "^6.5.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
