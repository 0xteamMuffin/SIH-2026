generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  REVIEWER
}

enum RunStatus {
  PENDING
  RUNNING
  WAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum RunToolCallStatus {
  PENDING
  RUNNING
  WAITING_APPROVAL
  COMPLETED
  FAILED
  REJECTED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ToolRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum EvidenceKind {
  SOURCE
  MODEL_OUTPUT
}

enum ArtifactKind {
  SOURCE
  GENERATED_DOCX
  CODE_OUTPUT
}

enum DataClassification {
  PUBLIC
  SYNTHETIC
  INTERNAL
  CONFIDENTIAL
}

enum ArtifactExtractionStatus {
  NOT_REQUIRED
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ArtifactLifecycleStatus {
  ACTIVE
  DELETING
  DELETED
}

enum ArtifactDeletionJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ModelInvocationStatus {
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum KnowledgeVisibility {
  WORKSPACE_PRIVATE
  ORGANIZATION_SHARED
}

enum KnowledgeSourceStatus {
  ACTIVE
  ARCHIVED
  DELETING
  DELETED
}

enum KnowledgeIndexStatus {
  PROVISIONING
  ACTIVE
  RETIRING
  RETIRED
  DELETING
  DELETED
  FAILED
}

enum KnowledgeSourceIndexStatus {
  PENDING
  INDEXING
  READY
  STALE
  REMOVING
  REMOVED
  FAILED
}

enum KnowledgeJobType {
  INDEX_SOURCE
  REMOVE_SOURCE
  REBUILD_INDEX
  EXECUTE_QUERY
  RECONCILE_INDEX
}

enum KnowledgeJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum KnowledgeQueryStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum EmbeddingPurpose {
  INDEX
  QUERY
}

enum EmbeddingInvocationStatus {
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum KnowledgeVectorDistance {
  COSINE
  EUCLID
  DOT
  MANHATTAN
}

model User {
  id                   String                @id @default(uuid()) @db.Uuid
  email                String                @unique
  passwordHash         String                @map("password_hash")
  role                 UserRole              @default(OPERATOR)
  disabledAt           DateTime?             @map("disabled_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  workspaces           Workspace[]           @relation("WorkspaceCreator")
  memberships          WorkspaceMember[]
  refreshSessions      RefreshSession[]
  artifacts            Artifact[]
  runs                 AgentRun[]
  auditEvents          AuditEvent[]
  knowledgeSources     KnowledgeSource[]
  knowledgeQueries     KnowledgeQuery[]
  approvalDecisions    ToolApproval[]        @relation("ApprovalDecider")
  artifactDeletionJobs ArtifactDeletionJob[] @relation("ArtifactDeletionRequester")

  @@map("users")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("refresh_sessions")
}

model Workspace {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  createdBy        String            @map("created_by") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at")
  creator          User              @relation("WorkspaceCreator", fields: [createdBy], references: [id])
  members          WorkspaceMember[]
  artifacts        Artifact[]
  runs             AgentRun[]
  auditEvents      AuditEvent[]
  knowledgeSources KnowledgeSource[]
  knowledgeJobs    KnowledgeJob[]
  knowledgeQueries KnowledgeQuery[]
  toolApprovals    ToolApproval[]

  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String    @map("workspace_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  role        UserRole  @default(OPERATOR)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@map("workspace_members")
}

model Artifact {
  id                  String                   @id @default(uuid()) @db.Uuid
  workspaceId         String                   @map("workspace_id") @db.Uuid
  createdBy           String                   @map("created_by") @db.Uuid
  kind                ArtifactKind
  classification      DataClassification       @default(INTERNAL)
  sha256              String?
  detectedMimeType    String?                  @map("detected_mime_type")
  extractionStatus    ArtifactExtractionStatus @default(NOT_REQUIRED) @map("extraction_status")
  extractedObjectKey  String?                  @map("extracted_object_key")
  extractionMetadata  Json?                    @map("extraction_metadata")
  extractionError     String?                  @map("extraction_error")
  extractionStartedAt DateTime?                @map("extraction_started_at")
  extractedAt         DateTime?                @map("extracted_at")
  filename            String
  mimeType            String                   @map("mime_type")
  objectKey           String                   @unique @map("object_key")
  sizeBytes           BigInt                   @map("size_bytes")
  versionSetId        String                   @map("version_set_id") @db.Uuid
  version             Int                      @default(1)
  previousVersionId   String?                  @unique @map("previous_version_id") @db.Uuid
  lifecycleStatus     ArtifactLifecycleStatus  @default(ACTIVE) @map("lifecycle_status")
  retentionUntil      DateTime?                @map("retention_until")
  deletionRequestedAt DateTime?                @map("deletion_requested_at")
  deletedAt           DateTime?                @map("deleted_at")
  createdAt           DateTime                 @default(now()) @map("created_at")
  workspace           Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator             User                     @relation(fields: [createdBy], references: [id])
  evidence            Evidence[]
  knowledgeSource     KnowledgeSource?
  sourceRuns          AgentRun[]               @relation("AgentRunSourceArtifact")
  previousVersion     Artifact?                @relation("ArtifactVersions", fields: [previousVersionId], references: [id], onDelete: Restrict)
  nextVersion         Artifact?                @relation("ArtifactVersions")
  deletionJob         ArtifactDeletionJob?

  @@unique([versionSetId, version])
  @@index([workspaceId, extractionStatus])
  @@index([workspaceId, lifecycleStatus, createdAt])
  @@map("artifacts")
}

model ArtifactDeletionJob {
  id             String                    @id @default(uuid()) @db.Uuid
  artifactId     String                    @unique @map("artifact_id") @db.Uuid
  requestedBy    String                    @map("requested_by") @db.Uuid
  status         ArtifactDeletionJobStatus @default(QUEUED)
  attempts       Int                       @default(0)
  maxAttempts    Int                       @default(4) @map("max_attempts")
  availableAt    DateTime                  @default(now()) @map("available_at")
  leaseId        String?                   @map("lease_id") @db.Uuid
  leaseExpiresAt DateTime?                 @map("lease_expires_at")
  lastError      String?                   @map("last_error")
  startedAt      DateTime?                 @map("started_at")
  completedAt    DateTime?                 @map("completed_at")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")
  artifact       Artifact                  @relation(fields: [artifactId], references: [id], onDelete: Restrict)
  requester      User                      @relation("ArtifactDeletionRequester", fields: [requestedBy], references: [id], onDelete: Restrict)

  @@index([status, availableAt])
  @@index([status, leaseExpiresAt])
  @@map("artifact_deletion_jobs")
}

model AgentRun {
  id                 String             @id @default(uuid()) @db.Uuid
  workspaceId        String             @map("workspace_id") @db.Uuid
  requestedBy        String             @map("requested_by") @db.Uuid
  task               String
  taskCapability     String             @map("task_capability")
  modelProfile       String             @map("model_profile")
  modelReason        String             @map("model_reason")
  sourceArtifactId   String?            @map("source_artifact_id") @db.Uuid
  dataClassification DataClassification @default(INTERNAL) @map("data_classification")
  status             RunStatus          @default(PENDING)
  state              Json               @default("{}")
  result             Json?
  maxTurns           Int                @default(4) @map("max_turns")
  maxToolCalls       Int                @default(5) @map("max_tool_calls")
  deadlineAt         DateTime           @map("deadline_at")
  activeWorkspaceId  String?            @unique @map("active_workspace_id") @db.Uuid
  leaseId            String?            @map("lease_id") @db.Uuid
  heartbeatAt        DateTime?          @map("heartbeat_at")
  leaseExpiresAt     DateTime?          @map("lease_expires_at")
  startedAt          DateTime?          @map("started_at")
  completedAt        DateTime?          @map("completed_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requester          User               @relation(fields: [requestedBy], references: [id])
  messages           RunMessage[]
  toolCalls          RunToolCall[]
  modelInvocations   ModelInvocation[]
  evidence           Evidence[]
  auditEvents        AuditEvent[]
  approvals          ToolApproval[]
  sourceArtifact     Artifact?          @relation("AgentRunSourceArtifact", fields: [sourceArtifactId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([sourceArtifactId, status])
  @@map("agent_runs")
}

model ModelInvocation {
  id               String                @id @default(uuid()) @db.Uuid
  runId            String                @map("run_id") @db.Uuid
  providerId       String                @map("provider_id")
  profileId        String                @map("profile_id")
  modelId          String                @map("model_id")
  attempt          Int
  status           ModelInvocationStatus @default(RUNNING)
  latencyMs        Int?                  @map("latency_ms")
  promptTokens     Int?                  @map("prompt_tokens")
  completionTokens Int?                  @map("completion_tokens")
  totalTokens      Int?                  @map("total_tokens")
  finishReason     String?               @map("finish_reason")
  sanitizedError   String?               @map("sanitized_error")
  startedAt        DateTime              @default(now()) @map("started_at")
  completedAt      DateTime?             @map("completed_at")
  run              AgentRun              @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, attempt])
  @@index([runId, startedAt])
  @@map("model_invocations")
}

model RunMessage {
  id        String   @id @default(uuid()) @db.Uuid
  runId     String   @map("run_id") @db.Uuid
  turn      Int
  role      String
  content   Json
  createdAt DateTime @default(now()) @map("created_at")
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@map("run_messages")
}

model RunToolCall {
  id              String            @id @default(uuid()) @db.Uuid
  runId           String            @map("run_id") @db.Uuid
  modelToolCallId String            @map("model_tool_call_id")
  toolName        String            @map("tool_name")
  input           Json
  output          Json?
  status          RunToolCallStatus @default(PENDING)
  riskLevel       ToolRiskLevel     @default(LOW) @map("risk_level")
  idempotencyKey  String            @map("idempotency_key")
  startedAt       DateTime          @default(now()) @map("started_at")
  completedAt     DateTime?         @map("completed_at")
  run             AgentRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  approval        ToolApproval?

  @@unique([runId, modelToolCallId])
  @@unique([runId, idempotencyKey])
  @@map("run_tool_calls")
}

model ToolApproval {
  id           String         @id @default(uuid()) @db.Uuid
  runId        String         @map("run_id") @db.Uuid
  toolCallId   String         @unique @map("tool_call_id") @db.Uuid
  workspaceId  String         @map("workspace_id") @db.Uuid
  toolName     String         @map("tool_name")
  toolInput    Json           @map("tool_input")
  riskLevel    ToolRiskLevel  @map("risk_level")
  status       ApprovalStatus @default(PENDING)
  requestedAt  DateTime       @default(now()) @map("requested_at")
  decidedBy    String?        @map("decided_by") @db.Uuid
  decisionNote String?        @map("decision_note")
  decidedAt    DateTime?      @map("decided_at")
  run          AgentRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  toolCall     RunToolCall    @relation(fields: [toolCallId], references: [id], onDelete: Cascade)
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  decider      User?          @relation("ApprovalDecider", fields: [decidedBy], references: [id])

  @@index([workspaceId, status, requestedAt])
  @@index([runId, status])
  @@map("tool_approvals")
}

model Evidence {
  id         String       @id @default(uuid()) @db.Uuid
  runId      String       @map("run_id") @db.Uuid
  artifactId String?      @map("artifact_id") @db.Uuid
  sourceRef  String       @map("source_ref")
  kind       EvidenceKind @default(SOURCE)
  title      String
  summary    String
  facts      Json         @default("[]")
  createdAt  DateTime     @default(now()) @map("created_at")
  run        AgentRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  artifact   Artifact?    @relation(fields: [artifactId], references: [id])

  @@map("evidence")
}

model AuditEvent {
  id          String     @id @default(uuid()) @db.Uuid
  actorId     String?    @map("actor_id") @db.Uuid
  workspaceId String?    @map("workspace_id") @db.Uuid
  runId       String?    @map("run_id") @db.Uuid
  eventType   String     @map("event_type")
  metadata    Json       @default("{}")
  createdAt   DateTime   @default(now()) @map("created_at")
  actor       User?      @relation(fields: [actorId], references: [id])
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  run         AgentRun?  @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("audit_events")
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  topic       String
  aggregateId String    @map("aggregate_id") @db.Uuid
  payload     Json
  attempts    Int       @default(0)
  availableAt DateTime  @default(now()) @map("available_at")
  publishedAt DateTime? @map("published_at")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([publishedAt, availableAt])
  @@map("outbox_events")
}

model KnowledgeSource {
  id            String                 @id @default(uuid()) @db.Uuid
  workspaceId   String                 @map("workspace_id") @db.Uuid
  artifactId    String                 @unique @map("artifact_id") @db.Uuid
  createdBy     String                 @map("created_by") @db.Uuid
  visibility    KnowledgeVisibility    @default(WORKSPACE_PRIVATE)
  status        KnowledgeSourceStatus  @default(ACTIVE)
  revision      Int                    @default(1)
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  archivedAt    DateTime?              @map("archived_at")
  deletedAt     DateTime?              @map("deleted_at")
  workspace     Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  artifact      Artifact               @relation(fields: [artifactId], references: [id])
  creator       User                   @relation(fields: [createdBy], references: [id])
  sourceIndexes KnowledgeSourceIndex[]

  @@index([workspaceId, visibility, status])
  @@map("knowledge_sources")
}

model KnowledgeIndex {
  id                   String                  @id @default(uuid()) @db.Uuid
  fingerprint          String                  @unique
  collectionName       String                  @unique @map("collection_name")
  vectorName           String                  @map("vector_name")
  profileId            String                  @map("profile_id")
  providerId           String                  @map("provider_id")
  modelId              String                  @map("model_id")
  revision             Int
  dimensions           Int
  distance             KnowledgeVectorDistance
  chunkerVersion       String                  @map("chunker_version")
  status               KnowledgeIndexStatus    @default(PROVISIONING)
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")
  activatedAt          DateTime?               @map("activated_at")
  retiredAt            DateTime?               @map("retired_at")
  sourceIndexes        KnowledgeSourceIndex[]
  jobs                 KnowledgeJob[]
  queries              KnowledgeQuery[]
  embeddingInvocations EmbeddingInvocation[]

  @@index([status, createdAt])
  @@map("knowledge_indexes")
}

model KnowledgeSourceIndex {
  id                   String                     @id @default(uuid()) @db.Uuid
  sourceId             String                     @map("source_id") @db.Uuid
  indexId              String                     @map("index_id") @db.Uuid
  sourceRevision       Int                        @map("source_revision")
  indexRevision        Int                        @map("index_revision")
  status               KnowledgeSourceIndexStatus @default(PENDING)
  chunkCount           Int                        @default(0) @map("chunk_count")
  sourceChecksum       String?                    @map("source_checksum")
  chunkSetChecksum     String?                    @map("chunk_set_checksum")
  leaseId              String?                    @map("lease_id") @db.Uuid
  heartbeatAt          DateTime?                  @map("heartbeat_at")
  leaseExpiresAt       DateTime?                  @map("lease_expires_at")
  lastError            String?                    @map("last_error")
  indexedAt            DateTime?                  @map("indexed_at")
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")
  source               KnowledgeSource            @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  index                KnowledgeIndex             @relation(fields: [indexId], references: [id], onDelete: Cascade)
  jobs                 KnowledgeJob[]
  embeddingInvocations EmbeddingInvocation[]

  @@unique([sourceId, indexId])
  @@index([indexId, status])
  @@index([status, leaseExpiresAt])
  @@map("knowledge_source_indexes")
}

model KnowledgeJob {
  id                   String                @id @default(uuid()) @db.Uuid
  workspaceId          String?               @map("workspace_id") @db.Uuid
  indexId              String                @map("index_id") @db.Uuid
  sourceIndexId        String?               @map("source_index_id") @db.Uuid
  queryId              String?               @unique @map("query_id") @db.Uuid
  type                 KnowledgeJobType
  status               KnowledgeJobStatus    @default(QUEUED)
  idempotencyKey       String                @unique @map("idempotency_key")
  attempts             Int                   @default(0)
  maxAttempts          Int                   @default(3) @map("max_attempts")
  availableAt          DateTime              @default(now()) @map("available_at")
  leaseId              String?               @map("lease_id") @db.Uuid
  heartbeatAt          DateTime?             @map("heartbeat_at")
  leaseExpiresAt       DateTime?             @map("lease_expires_at")
  lastError            String?               @map("last_error")
  startedAt            DateTime?             @map("started_at")
  completedAt          DateTime?             @map("completed_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  workspace            Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  index                KnowledgeIndex        @relation(fields: [indexId], references: [id], onDelete: Cascade)
  sourceIndex          KnowledgeSourceIndex? @relation(fields: [sourceIndexId], references: [id], onDelete: Restrict)
  query                KnowledgeQuery?       @relation(fields: [queryId], references: [id], onDelete: Cascade)
  embeddingInvocations EmbeddingInvocation[]

  @@index([status, availableAt])
  @@index([status, leaseExpiresAt])
  @@index([workspaceId, createdAt])
  @@index([indexId, createdAt])
  @@map("knowledge_jobs")
}

model KnowledgeQuery {
  id                   String                @id @default(uuid()) @db.Uuid
  workspaceId          String                @map("workspace_id") @db.Uuid
  requestedBy          String                @map("requested_by") @db.Uuid
  indexId              String                @map("index_id") @db.Uuid
  indexRevision        Int                   @map("index_revision")
  dataClassification   DataClassification    @default(INTERNAL) @map("data_classification")
  status               KnowledgeQueryStatus  @default(QUEUED)
  queryText            String                @map("query_text")
  topK                 Int                   @default(10) @map("top_k")
  filters              Json                  @default("{}")
  result               Json?
  lastError            String?               @map("last_error")
  startedAt            DateTime?             @map("started_at")
  completedAt          DateTime?             @map("completed_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  workspace            Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requester            User                  @relation(fields: [requestedBy], references: [id])
  index                KnowledgeIndex        @relation(fields: [indexId], references: [id], onDelete: Cascade)
  job                  KnowledgeJob?
  embeddingInvocations EmbeddingInvocation[]

  @@index([workspaceId, createdAt])
  @@index([status, createdAt])
  @@map("knowledge_queries")
}

model EmbeddingInvocation {
  id              String                    @id @default(uuid()) @db.Uuid
  jobId           String                    @map("job_id") @db.Uuid
  indexId         String                    @map("index_id") @db.Uuid
  sourceIndexId   String?                   @map("source_index_id") @db.Uuid
  queryId         String?                   @map("query_id") @db.Uuid
  purpose         EmbeddingPurpose
  providerId      String                    @map("provider_id")
  profileId       String                    @map("profile_id")
  modelId         String                    @map("model_id")
  batch           Int                       @default(0)
  attempt         Int                       @default(1)
  status          EmbeddingInvocationStatus @default(RUNNING)
  inputCount      Int                       @map("input_count")
  inputCharacters Int                       @map("input_characters")
  inputTokens     Int?                      @map("input_tokens")
  dimensions      Int
  latencyMs       Int?                      @map("latency_ms")
  sanitizedError  String?                   @map("sanitized_error")
  startedAt       DateTime                  @default(now()) @map("started_at")
  completedAt     DateTime?                 @map("completed_at")
  job             KnowledgeJob              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  index           KnowledgeIndex            @relation(fields: [indexId], references: [id], onDelete: Cascade)
  sourceIndex     KnowledgeSourceIndex?     @relation(fields: [sourceIndexId], references: [id], onDelete: Cascade)
  query           KnowledgeQuery?           @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@unique([jobId, batch, attempt])
  @@index([indexId, startedAt])
  @@index([sourceIndexId, startedAt])
  @@index([queryId, startedAt])
  @@map("embedding_invocations")
}
